pipeline {
    agent any

    tools {
        maven 'maven3'
    }

    environment {
        IMAGE_NAME = 'devopshubg333/batch13'
        GITOPS_REPO = 'https://github.com/sivakalyanb/mindcircuit13-main.git'
        GITOPS_BRANCH = 'main'
        SONAR_HOST_URL = 'http://44.210.116.12:9000'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${GITOPS_BRANCH}", url: "${GITOPS_REPO}"
            }
        }

        stage('Detect GitOps update') {
            steps {
                script {
                    def commitMessage = sh(
                        script: 'git log -1 --format=%s',
                        returnStdout: true
                    ).trim()
                    env.SKIP_PIPELINE = commitMessage.startsWith('Update deployment image to version ') ? 'true' : 'false'
                }
            }
        }

        stage('SonarQube analysis') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                    sh 'mvn sonar:sonar -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_TOKEN'
                }
            }
        }

        stage('Build Artifact') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Build and Push Image') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                withCredentials([string(credentialsId: 'dockerhub', variable: 'DOCKERHUB_TOKEN')]) {
                    sh '''
                        docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                        printf '%s' "$DOCKERHUB_TOKEN" | docker login --username devopshubg333 --password-stdin
                        docker push ${IMAGE_NAME}:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Update GitOps manifest') {
            when {
                expression { env.SKIP_PIPELINE != 'true' }
            }
            steps {
                withCredentials([string(credentialsId: 'githubtoken', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        set +x
                        sed -i "s|image: ${IMAGE_NAME}:.*|image: ${IMAGE_NAME}:${BUILD_NUMBER}|" deploymentfiles/deployment.yml
                        git config user.email "jenkins@users.noreply.github.com"
                        git config user.name "Jenkins"
                        git add deploymentfiles/deployment.yml

                        if git diff --cached --quiet; then
                            echo "Deployment image is unchanged; nothing to commit."
                        else
                            git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                            AUTH_HEADER=$(printf 'x-access-token:%s' "$GITHUB_TOKEN" | base64 | tr -d '\\n')
                            git -c http.extraheader="AUTHORIZATION: basic ${AUTH_HEADER}" push "$GITOPS_REPO" HEAD:${GITOPS_BRANCH}
                        fi
                    '''
                }
            }
        }
    }
}
